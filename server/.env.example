# ── server（远程服务器上运行）────────────────────────────────────────
# 复制为 .env 后填写。权限设成 600。

# 监听地址。放在 nginx 后面时保持 127.0.0.1，不要暴露到公网。
HOST=127.0.0.1
PORT=8787

# 网页登录用的访问令牌 —— 你自己设，够长够随机。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN=

# 本地 agent-host 连接用的共享密钥，必须与 agent-host/.env 里的 AGENT_SECRET 一致。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# cookie 签名密钥。留空则自动由 ACCESS_TOKEN 派生；建议单独生成，
# 这样轮换 ACCESS_TOKEN 不会把已登录设备全部踢下线。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 登录态有效期（天）
SESSION_TTL_DAYS=30

# 生产环境走 https 时必须设为 true，否则 cookie 会被浏览器拒收
SECURE_COOKIES=true

# faster-whisper 转写服务地址（本机回环即可）
WHISPER_URL=http://127.0.0.1:8001
# 与 whisper/.env 的 WHISPER_TOKEN 一致，留空则该服务不校验
WHISPER_TOKEN=

# 单次上传音频大小上限（MB）
MAX_UPLOAD_MB=25

# 前端构建产物目录，相对 server 包根目录
PUBLIC_DIR=public

# 部署在 nginx / Cloudflare 之后时读 X-Forwarded-For 作为客户端 IP
TRUST_PROXY=true
