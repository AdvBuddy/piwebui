# ── agent-host（本地机器上运行的桥接进程）────────────────────────────
# 复制为 .env 后填写。.env 不要提交到 git。

# 中转服务器地址。本地测试用 ws://127.0.0.1:8787/agent
# 生产用 wss://你的域名/agent（nginx 反代到 127.0.0.1:8787）
PIWEBUI_SERVER_URL=ws://127.0.0.1:8787/agent

# 必须与服务器端 .env 的 AGENT_SECRET 完全一致
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# pi 的工作目录 —— 也就是 agent 能读写文件、执行命令的项目根目录
PI_CWD=C:\Users\Frank\Documents\CodeDevs\piwebui

# pi 可执行文件。全局安装后通常就是 pi
PI_BIN=pi

# 追加给 pi 的参数，空格分隔。例如：
#   --approve            信任项目级 AGENTS.md / 本地扩展
#   --model anthropic/claude-sonnet-4-5
#   --thinking high
PI_ARGS=

# 会话文件目录，留空用默认 ~/.pi/agent/sessions
PI_SESSION_DIR=

# pi 异常退出后自动重启
PI_AUTO_RESTART=true

# 网页上显示的机器名
PIWEBUI_HOST_NAME=

# 打印完整协议收发（排障用，日志很多）
PIWEBUI_VERBOSE=false
