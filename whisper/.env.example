# ── whisper 转写服务（远程服务器上运行）──────────────────────────────
# 复制为 .env（systemd unit 会读取）。

# 模型规模：tiny / base / small / medium / large-v3
# 中文场景建议 small 起步，机器够力就 medium；large-v3 需要 GPU 才实用。
WHISPER_MODEL=small

# cpu / cuda
WHISPER_DEVICE=cpu

# CPU 用 int8，GPU 用 float16
WHISPER_COMPUTE_TYPE=int8

# 0 = 让 CTranslate2 自己决定
WHISPER_CPU_THREADS=0

# 识别语言，zh 为中文；auto 为自动检测
WHISPER_LANGUAGE=zh

WHISPER_BEAM_SIZE=5

# 领域提示词。写入常用的技术词汇能显著改善标点与专有名词。
# 例：WHISPER_INITIAL_PROMPT=以下是普通话的技术讨论，涉及代码、部署、服务器。
WHISPER_INITIAL_PROMPT=

# 与 server/.env 的 WHISPER_TOKEN 一致；留空则不校验（仅限 127.0.0.1 监听时）
WHISPER_TOKEN=

WHISPER_HOST=127.0.0.1
WHISPER_PORT=8001

# 单次音频上限（MB）
WHISPER_MAX_MB=30

# 国内网络下载模型慢时，指向镜像（两个都要设：只设镜像会被 Xet 协议卡住）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1
